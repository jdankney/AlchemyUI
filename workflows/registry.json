          0.6
        ],
        "face_guide": [
          384,
          768
        ]
      },
      "choices": {
        "sampler": [
          "dpmpp_2m",
          "dpmpp_2m_sde",
          "dpmpp_3m_sde",
          "euler",
          "euler_ancestral",
          "ddim",
          "uni_pc"
        ],
        "scheduler": [
          "karras",
          "normal",
          "simple",
          "sgm_uniform",
          "exponential",
          "beta"
        ]
      },
      "progress_node": "24",
      "stages": [
        {
          "node": "24",
          "label": "Refining detail",
          "weight": 2.0
        },
        {
          "node": "27",
          "label": "Faces",
          "weight": 0.4
        }
      ],
      "output_node": "9",
      "est": {
        "seconds_per_step": 12.0,
        "load_s": 35
      },
      "_chain_note": "Two settings were tuned against measured runs on a GTX 1660 Ti rather than taken from the node defaults. force_inpaint is False in the template: with it True, Impact Pack falls back to sampling the entire crop whenever the detected face is already larger than guide_size, which on a portrait means re-rendering the whole image for no resolution gain (~5 minutes here). False makes it skip that case, which is the point of a detail pass. refine_steps is 14, not 25: the hi-res pass runs at denoise 0.35, so 25 steps traverses the same short stretch of the schedule far more finely than the result justifies."
    },
