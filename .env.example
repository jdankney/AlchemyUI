# AlchemyUI configuration. Copy to .env and edit. .env is gitignored.
# Values here are also the documented defaults for anything optional.

# ---------------------------------------------------------------------------
# ComfyUI
# ---------------------------------------------------------------------------
# The app is the ONLY thing that talks to ComfyUI. Never expose 8188 to a
# browser: it has no auth and /prompt accepts arbitrary graphs, which means
# arbitrary node execution and filesystem access.
COMFYUI_URL=http://127.0.0.1:8188

# ---------------------------------------------------------------------------
# Binding / storage
# ---------------------------------------------------------------------------
APP_BIND_HOST=127.0.0.1
PORT=8300

# Generated images are copied OUT of ComfyUI's output/ into app-owned storage,
# one directory per job. ComfyUI's own folder layout is not a stable contract.
# OUTPUT_DIR=./data/outputs
# DATABASE_PATH=./data/alchemyui.db
# WORKFLOWS_DIR=./workflows

# ---------------------------------------------------------------------------
# Uploads (img2img / inpaint / outpaint)
# ---------------------------------------------------------------------------
# UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=24
# Longest edge an uploaded image is scaled to. Every pixel above this is GPU
# time and VRAM you pay for; 6GB runs out well before patience does. Sizes are
# also snapped to a multiple of 8, which the VAE requires -- without that,
# VAEEncodeForInpaint crops silently and the mask no longer lines up.
UPLOAD_MAX_EDGE=1536

# ---------------------------------------------------------------------------
# Quality chain (Enhance, and the high-quality toggle)
# ---------------------------------------------------------------------------
# The chain upscales 4x and scales back down, so the output edge is
# 4 x source x scale_by. On a 1024px base the tuned 0.38 lands at ~1556px,
# which a 6GB card handles; from a 1344px base it would be 2043px and the
# sampler runs out of VRAM. scale_by is lowered per job to hold this ceiling,
# so the chain degrades to less upscaling rather than failing.
HQ_MAX_EDGE=1600

# ---------------------------------------------------------------------------
# Reference faces (Likeness)
# ---------------------------------------------------------------------------
# AlchemyUI checks each reference photo for a face as it is uploaded, so a bad
# one is refused by name instead of killing a job minutes later -- InsightFace
# fails the whole batch if any single image has no detectable face. It reads
# ComfyUI's own buffalo_l models rather than downloading a second copy, and
# runs on the CPU so the GPU stays with the sampler.
INSIGHTFACE_ROOT=~/ComfyUI/models/insightface

# Every reference is cropped square around the face at this size. Identical
# dimensions are what stop ImageBatch rescaling and cropping the second
# reference onwards, which can slice a face out of frame.
REFERENCE_SIZE=768
MAX_REFERENCES=4

# FaceID weight used when a personal LoRA is also active. Both encode identity
# and fight each other at full strength.
LORA_FACE_WEIGHT=0.45

# ---------------------------------------------------------------------------
# Queue ordering and batches
# ---------------------------------------------------------------------------
# A checkpoint swap costs 30s+, so a job whose model is already loaded may jump
# ahead -- but only within this many places, and only until something has been
# passed over this many times. With one checkpoint in play neither does
# anything, and strict FIFO is always the fallback.
QUEUE_REORDER_WINDOW=6
QUEUE_MAX_SKIPS=3

# Batch generation runs this many separate jobs at most, one after another.
# Also the most images one chat message may ask for ("give me 4 variations").
MAX_BATCH=4

# ---------------------------------------------------------------------------
# Router (v2: the chat) -- a small LLM turns each message into a plan
# ---------------------------------------------------------------------------
# It never writes a graph, only a plan in a closed vocabulary that code checks
# and turns into jobs. Primary: Llamacracy's /v1, as a dedicated account with
# its own API key. Leave the URL or model empty to go without it. The model
# should have a vision projector (mmproj) so it can see attachments; if it
# cannot, messages with images go to the fallback below.
ROUTER_PRIMARY_URL=
ROUTER_PRIMARY_KEY=
# e.g. gemma4-e4b-uncensored -- chosen with `alchemyui router-eval`
ROUTER_PRIMARY_MODEL=
# Llamacracy queues us like anyone else and may have to wake the model.
ROUTER_TIMEOUT_S=45

# Fallback: a CPU-only llama-server on this machine (the alchemyui-router unit,
# installed by deploy/install.sh once the two paths below exist). Empty URL
# disables it. It never touches the GPU.
ROUTER_FALLBACK_URL=http://127.0.0.1:8081/v1
ROUTER_FALLBACK_MODEL=gemma4-e4b
ROUTER_FALLBACK_PORT=8081
ROUTER_FALLBACK_GGUF=/path/to/gemma-4-E4B-it-qat-UD-Q4_K_XL.gguf
ROUTER_FALLBACK_MMPROJ=/path/to/mmproj-BF16.gguf
# CPU prompt processing of an image is slow; this is a fallback, not a race.
ROUTER_FALLBACK_TIMEOUT_S=240

# How many earlier messages of a conversation the router is told about (as
# text: earlier images are described by their prompts, never sent).
ROUTER_CONTEXT_TURNS=6

# ---------------------------------------------------------------------------
# Identity (v2: multi-user)
# ---------------------------------------------------------------------------
# Locally: DEV_MODE=1 and one fake identity, no login. For friends over
# NetBird, oauth2-proxy (deploy/install.sh) authenticates against
# Llamacracy's Dex and forwards the user; unset DEV_MODE then -- the app
# requires the X-Forwarded-* headers and refuses to serve without them, so it
# can never accidentally run open. Users are keyed on the OIDC sub.
DEV_MODE=1
DEV_EMAIL=dev@localhost
DEV_NAME=Dev User

# Comma-separated. Who may open /admin. Include DEV_EMAIL for local use. The
# first admin to sign in inherits every image and job v1 left behind;
# `alchemyui reassign FROM TO` moves them later if that was the wrong account.
ADMIN_EMAILS=dev@localhost

# ---------------------------------------------------------------------------
# Metering -- visibility, never limits
# ---------------------------------------------------------------------------
# Each job's energy = (measured GPU draw + NON_GPU_LOAD_WATTS) x the time it
# held the GPU. CPU is estimated because Intel RAPL is root-only here.
NON_GPU_LOAD_WATTS=25
# Used only when nvidia-smi gave no reading for a job.
GPU_FALLBACK_WATTS=60
# $/kWh. TOU_SCHEDULE, if set, wins: JSON of local hour -> $/kWh, e.g.
# {"0":0.31,"16":0.52,"21":0.31}; hours it omits use ELECTRICITY_RATE.
ELECTRICITY_RATE=0.30
TOU_SCHEDULE=

# ---------------------------------------------------------------------------
# Queue
# ---------------------------------------------------------------------------
# One GPU, strictly serial, app-owned FIFO. ComfyUI's internal queue is not the
# source of truth -- we submit one job at a time.

# How long to wait for ComfyUI to start executing a submitted prompt before
# giving up on it (it may be busy with work submitted from its own UI).
JOB_START_TIMEOUT_S=900

# Weight of each new observation in the per-workflow duration EWMA. Seeded from
# the registry's `est` block until real runs are observed.
EWMA_ALPHA=0.3
