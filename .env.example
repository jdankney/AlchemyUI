# AlchemyUI configuration. Copy to .env and edit. .env is gitignored.
# Values here are also the documented defaults for anything optional.

# ---------------------------------------------------------------------------
# ComfyUI
# ---------------------------------------------------------------------------
# The app is the ONLY thing that talks to ComfyUI. Never expose 8188 to a
# browser: it has no auth and /prompt accepts arbitrary graphs, which means
# arbitrary node execution and filesystem access.
COMFYUI_URL=http://127.0.0.1:8188

# ---------------------------------------------------------------------------
# Binding / storage
# ---------------------------------------------------------------------------
APP_BIND_HOST=127.0.0.1
PORT=8300

# Generated images are copied OUT of ComfyUI's output/ into app-owned storage,
# one directory per job. ComfyUI's own folder layout is not a stable contract.
# OUTPUT_DIR=./data/outputs
# DATABASE_PATH=./data/alchemyui.db
# WORKFLOWS_DIR=./workflows

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# Single user by default: bind 127.0.0.1 and set DEV_MODE=1. There is no auth
# code in the app. For friends over NetBird, put an oauth2-proxy in front
# (register a second client in Llamacracy's existing Dex) and leave DEV_MODE
# unset -- the app then requires the X-Forwarded-* headers and refuses to serve
# without them, so it can never accidentally run open.
DEV_MODE=1
DEV_EMAIL=dev@localhost
DEV_NAME=Dev User

# ---------------------------------------------------------------------------
# Queue
# ---------------------------------------------------------------------------
# One GPU, strictly serial, app-owned FIFO. ComfyUI's internal queue is not the
# source of truth -- we submit one job at a time.

# How long to wait for ComfyUI to start executing a submitted prompt before
# giving up on it (it may be busy with work submitted from its own UI).
JOB_START_TIMEOUT_S=900

# Weight of each new observation in the per-workflow duration EWMA. Seeded from
# the registry's `est` block until real runs are observed.
EWMA_ALPHA=0.3
